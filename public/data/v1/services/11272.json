{
  "id": "https://servicos.gov.br/api/v1/servicos/11272",
  "nome": "Solicitar autorização para ingresso na Rede CAF",
  "sigla": "",
  "descricao": "É o processo para que entidades públicas ou privadas sem fins lucrativos solicitem autorização para fazer parte da Rede CAF como emissoras.\n\n A entidade credenciada é responsável por organizar e atender as pessoas que querem se inscrever no Cadastro Nacional da Agricultura Familiar (CAF).\n\n O Departamento de Cadastro Nacional do CAF analisa cada pedido, levando em conta a necessidade do serviço na região, a estrutura e capacidade da entidade e os critérios definidos pelo órgão gestor do CAF.",
  "flagPortalLogado": "S",
  "contato": "E-mail: [caf@mda.gov.br](mailto:caf@mda.gov.br)",
  "gratuito": "true",
  "porcentagemDigital": 100,
  "servicoDigital": true,
  "linkServicoDigital": "http://solicitacao.servicos.gov.br/processos/iniciar",
